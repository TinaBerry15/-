# Apple Music (MusicKit) 用。Apple Developer Program のメンバーシップが必要。
#   1. https://developer.apple.com/account/resources/authkeys/list で
#      "Media Services (MusicKit)" を有効にした鍵を作成
#   2. AuthKey_XXXXXXXXXX.p8 を ./secrets/ に置く (.gitignore 済み)
#   3. この3つを埋めて `cp .env.example .env`
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_YYYYYYYYYY.p8

# 任意: 待ち受けポート (既定 8787)
# PORT=8787
